# Copy thành .env.local rồi điền giá trị thật. KHÔNG commit file .env.local.

# URL của backend, dùng ở PHÍA SERVER (Server Component, Route Handler).
# Không có tiền tố NEXT_PUBLIC_ nên biến này không bị nhúng vào bundle client — đúng ý:
# trình duyệt không gọi thẳng backend, mọi lời gọi cần xác thực đều đi qua server Next.
API_BASE_URL=http://localhost:8080

# Chỉ đặt biến ở đây nếu client THẬT SỰ cần đọc.
# ⚠️ Mọi biến NEXT_PUBLIC_* đều được nhúng vào bundle và ai cũng đọc được.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
